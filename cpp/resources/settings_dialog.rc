// MaxPane Settings dialog (Sprint 3.1 / ADR-019).
//
// Originally planned with tabs + radio groups per ADR-019 — pivoted to a
// single-page layout with a cycle-button for dark-mode. SWELL's .rc
// macro vocabulary covers CHECKBOX / PUSHBUTTON / EDITTEXT / LTEXT but
// not AUTOCHECKBOX / AUTORADIOBUTTON / SysTabControl32 cleanly, and
// keeping the .rc cross-platform (Win32 rc.exe vs SWELL resgen) means
// sticking to the intersection.
//
// v2.0.4 #4 (ADR-040) — compact pass per owner feedback "ogromne wzgledem
// ilosci funkcji". Was 360x380; now 360x296 (~22% shorter). Changes:
//   - Tighter section-header → first-control gaps (14 → 6).
//   - "Color mode:" label inlined to the left of the cycle button.
//   - HOTKEYS description shortened from 3 lines to 1.
//   - UPDATES split out of ABOUT as its own section (button + auto-
//     checkbox on a single row).
//   - Bottom button breathing space cut from 47 to 22.
// ADR-055 — third GENERAL checkbox (single-tab bar collapse); sections
// below shifted +16, dialog height 280 → 296.
// U12/U13 (ADR-068) — fourth GENERAL checkbox (clean mode) + APPEARANCE
// "Pane border:" preset cycle row; sections below shifted +36, dialog
// height 296 → 330.
// U15 (ADR-069) — fifth GENERAL checkbox (taskbar hide); +16 again,
// height 330 → 346.
// U14 (ADR-070) — sixth GENERAL checkbox (follow mode); +16, height 346 → 362.
// v2.4.0 (F7 + B2) — "Startup workspace:" dropdown row under auto-open
// (+20) and seventh GENERAL checkbox (tie floating to main, Windows; +16);
// height 362 → 398; (F12) eighth checkbox +16 → 414. COMBOBOX carries CBS_DROPDOWNLIST in BOTH branches —
// without it SWELL builds an EDITABLE NSComboBox on macOS.
// v2.4.0 platform gating — taskbar row is Windows-only, tie row is
// Windows+Linux; inert rows are not emitted elsewhere and everything below
// reflows statically via the SD_Y_* / SD_DLG_H constants in
// settings_dialog.h (truth table + per-platform heights documented there).

#ifdef _WIN32
#include <windows.h>
#endif
#include "settings_dialog.h"

IDD_SETTINGS DIALOGEX 0, 0, 360, SD_DLG_H
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | DS_MODALFRAME | DS_CENTER
CAPTION "MaxPane Settings"
BEGIN
    // ---- General ----
    LTEXT           "GENERAL", -1, 15, 8, 100, 10
#ifdef _WIN32
    // Sprint 1 Entry 7 — Win32 rc.exe compiles CHECKBOX as BS_CHECKBOX
    // (manual-toggle). AUTOCHECKBOX (BS_AUTOCHECKBOX) flips state on click;
    // SWELL macOS already treats CHECKBOX as auto-toggling.
    AUTOCHECKBOX    "Open MaxPane automatically when REAPER starts",
                    IDC_SET_AUTOOPEN, 25, 22, 320, 14
    AUTOCHECKBOX    "Show navigation bar at top of every MaxPane",
                    IDC_SET_SHOWNAVBAR, 25, 58, 320, 14
    AUTOCHECKBOX    "Collapse tab bar when a pane has a single window",
                    IDC_SET_HIDETABBAR, 25, 74, 320, 14
    AUTOCHECKBOX    "Hide pane tab bars (clean mode)",
                    IDC_SET_HIDEALLTABS, 25, 90, 320, 14
    AUTOCHECKBOX    "Hide floating MaxPane from the taskbar",
                    IDC_SET_HIDETASKBAR, 25, 106, 320, 14
    AUTOCHECKBOX    "Follow selected track's FX (experimental)",
                    IDC_SET_FOLLOWFX, 25, SD_Y_FOLLOWFX, 320, 14
    AUTOCHECKBOX    "Tie floating MaxPane to REAPER's main window",
                    IDC_SET_TIEMAIN, 25, SD_Y_TIEMAIN, 320, 14
    AUTOCHECKBOX    "Focus FX when switching tabs (MIDI controller support)",
                    IDC_SET_FOCUSFX, 25, SD_Y_FOCUSFX, 320, 14
#else
    CHECKBOX        "Open MaxPane automatically when REAPER starts",
                    IDC_SET_AUTOOPEN, 25, 22, 320, 14
    CHECKBOX        "Show navigation bar at top of every MaxPane",
                    IDC_SET_SHOWNAVBAR, 25, 58, 320, 14
    CHECKBOX        "Collapse tab bar when a pane has a single window",
                    IDC_SET_HIDETABBAR, 25, 74, 320, 14
    CHECKBOX        "Hide pane tab bars (clean mode)",
                    IDC_SET_HIDEALLTABS, 25, 90, 320, 14
    CHECKBOX        "Follow selected track's FX (experimental)",
                    IDC_SET_FOLLOWFX, 25, SD_Y_FOLLOWFX, 320, 14
#ifndef __APPLE__
    CHECKBOX        "Tie floating MaxPane to REAPER's main window",
                    IDC_SET_TIEMAIN, 25, SD_Y_TIEMAIN, 320, 14
#endif
    CHECKBOX        "Focus FX when switching tabs (MIDI controller support)",
                    IDC_SET_FOCUSFX, 25, SD_Y_FOCUSFX, 320, 14
#endif
    // F7 (v2.4.0) — loads only when the project carries no MaxPane state;
    // "None" keeps the ADR-013 empty launcher. Height covers the open list.
    LTEXT           "Startup workspace:", -1, 25, 40, 80, 12
    COMBOBOX        IDC_SET_STARTWS, 110, 38, 190, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // ---- Appearance ----
    LTEXT           "APPEARANCE", -1, 15, SD_Y_SEC_APPEAR, 100, 10
    LTEXT           "Color mode:", IDC_SET_DARK_GROUP, 25, SD_Y_DARK_LBL, 60, 12
    PUSHBUTTON      "Auto (follow system)", IDC_SET_DARK_CYCLE,
                    90, SD_Y_DARK_BTN, 175, 18
    LTEXT           "Pane border:", IDC_SET_BORDER_GROUP, 25, SD_Y_BORDER_LBL, 60, 12
    PUSHBUTTON      "Default (system)", IDC_SET_BORDER_CYCLE,
                    90, SD_Y_BORDER_BTN, 175, 18

    // ---- Hotkeys ----
    LTEXT           "HOTKEYS", -1, 15, SD_Y_SEC_HOTKEYS, 100, 10
    LTEXT           "Right-click workspace cards to bind shortcuts. Browse all MaxPane actions:",
                    IDC_SET_HOTKEYS_LBL, 25, SD_Y_HOTKEYS_LBL, 320, 12
    PUSHBUTTON      "Open REAPER Actions...", IDC_SET_OPEN_ACTIONS,
                    25, SD_Y_ACTIONS_BTN, 130, 18

    // ---- Updates (v2.0.4 #3) ----
    LTEXT           "UPDATES", -1, 15, SD_Y_SEC_UPDATES, 100, 10
    PUSHBUTTON      "Check for updates", IDC_SET_CHECK_UPDATE,
                    25, SD_Y_UPDATE_BTN, 130, 18
#ifdef _WIN32
    AUTOCHECKBOX    "Automatically on REAPER startup",
                    IDC_SET_AUTO_UPDATE, 165, SD_Y_AUTO_UPDATE, 190, 14
#else
    CHECKBOX        "Automatically on REAPER startup",
                    IDC_SET_AUTO_UPDATE, 165, SD_Y_AUTO_UPDATE, 190, 14
#endif

    // ---- About (v2.0.3) ----
    LTEXT           "ABOUT", -1, 15, SD_Y_SEC_ABOUT, 100, 10
    // Sprint 1 Entry 7 — em-dash → "--": rc.exe defaults to ACP for
    // string literals. settings_dialog.cpp fills the actual version
    // string at WM_INITDIALOG time from MAXPANE_VERSION_STRING.
    LTEXT           "MaxPane (version filled at runtime)",
                    IDC_SET_VERSION_LBL, 25, SD_Y_VERSION_LBL, 320, 12
    LTEXT           "MIT License -- github.com/b451c/MaxPane",
                    IDC_SET_LICENSE_LBL, 25, SD_Y_LICENSE_LBL, 320, 12
    PUSHBUTTON      "GitHub", IDC_SET_GITHUB,      25, SD_Y_LINK_BTNS, 60, 18
    PUSHBUTTON      "Ko-fi",  IDC_SET_KOFI,        90, SD_Y_LINK_BTNS, 60, 18
    PUSHBUTTON      "BMC",    IDC_SET_BMC,        155, SD_Y_LINK_BTNS, 60, 18
    PUSHBUTTON      "PayPal", IDC_SET_PAYPAL,     220, SD_Y_LINK_BTNS, 60, 18

    // ---- Bottom button row ----
    PUSHBUTTON      "Reset", IDC_SET_RESET,
                    15, SD_Y_BOTTOM_BTNS, 60, 18
    DEFPUSHBUTTON   "OK", 1, 235, SD_Y_BOTTOM_BTNS, 55, 18
    PUSHBUTTON      "Cancel", 2, 295, SD_Y_BOTTOM_BTNS, 55, 18
END
