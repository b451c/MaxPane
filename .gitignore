# Build artifacts
cpp/build/
cpp/build-debug/

# External dependencies (cloned separately)
cpp/sdk/
cpp/WDL/

# Compiled binaries
*.dylib
*.dll
*.so
*.o
*.obj

# macOS
.DS_Store

# IDE / Editor
.vscode/
.idea/
*.xcodeproj/
*.swp
*~

# Debug logs
maxpane_debug.log

# SWELL dialog resgen output (generated from cpp/resources/*.rc by
# swell_resgen.pl at build time; macOS/Linux only)
cpp/resources/*.rc_mac_dlg
cpp/resources/*.rc_mac_menu

# Forum post drafts
forum_post*.txt
forum_reply*.txt
forum_replies.txt

# Bugfix handoff (temporary, between sessions)
cpp/BUGFIX_HANDOFF.md

# Local dev metadata — AI image-gen prompts used to produce the toolbar
# icons in Icons/. The generated PNGs are committed; the source prompts
# stay local (no value to distribution, large to diff).
assets/

# ASAN-instrumented build tree (separate from cpp/build/).
cpp/build_asan/

# Nested ReaBeat assets accidentally landed under Icons/toolbar_icons/
# during dev. Not part of MaxPane distribution — kept locally so the
# unrelated plugin's artwork stays available, but never committed.
Icons/toolbar_icons/toolbar_icons/

# Process documents — owner directive: public repo (GitHub) carries
# clean code + builds + user-facing docs only, never the dev process
# (audits, ADRs, session plans, AI assistant config). Everything below
# stays on the local disk; we just don't ship it anywhere remote.
CLAUDE.md
docs/v2/
docs/sprint1/
.claude/
Testing/
drafts/
